<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared MSBuild defaults for all projects under Applications/.
  Layout contract: Applications/README.md and AGENTS.md
-->
<Project>
  <!-- Map VS Platform / Configuration to Build/<os>-<arch>-<config>/ -->
  <PropertyGroup>
    <AppOs>win</AppOs>
    <AppArch Condition="'$(Platform)' == 'x64'">x64</AppArch>
    <AppArch Condition="'$(Platform)' == 'ARM64'">arm64</AppArch>
    <AppArch Condition="'$(AppArch)' == ''">$(Platform)</AppArch>
    <!-- NB: do not name this property "AppConfig". That is a reserved MSBuild
         property (path to App.config); overriding it makes the
         _CopyAppConfigFile target try to copy a file named e.g. "release",
         which breaks the .wapproj build. -->
    <AppBuildConfig Condition="'$(Configuration)' == 'Debug'">debug</AppBuildConfig>
    <AppBuildConfig Condition="'$(Configuration)' == 'Release'">release</AppBuildConfig>
    <AppBuildConfig Condition="'$(AppBuildConfig)' == ''">$(Configuration.ToLower())</AppBuildConfig>
  </PropertyGroup>

  <!--
    Custom OutDir/IntDir for the compiled projects. Skipped for MSIX packaging
    projects (.wapproj), which manage their own output layout under Build\msix\.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' != '.wapproj'">
    <!-- MSBuildThisFileDirectory is Applications/ (trailing slash). -->
    <OutDir>$(MSBuildThisFileDirectory)Build\$(AppOs)-$(AppArch)-$(AppBuildConfig)\$(MSBuildProjectName)\</OutDir>
    <IntDir>$(OutDir)obj\</IntDir>
  </PropertyGroup>

  <!-- Defaults applied to C/C++ projects that do not override them. -->
  <PropertyGroup>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0</WindowsTargetPlatformVersion>
    <!-- Windows 10 or later (covers Windows 10 and Windows 11). -->
    <AppTargetWindowsVersion>0x0A00</AppTargetWindowsVersion>
  </PropertyGroup>
</Project>
