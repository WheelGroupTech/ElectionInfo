<?xml version="1.0" encoding="utf-8"?>

<!--
  MSIX manifest for the Microsoft Store submission of Election Explorer.
  Identity (Name / Publisher / PublisherDisplayName) matches the values assigned
  by Partner Center for this app; keep them in sync if the listing changes.
-->

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <Identity
    Name="WheelGroupTech.ElectionExplorer"
    Publisher="CN=19C9DED9-26A0-4883-97F5-C2A81BF980D6"
    Version="1.0.1.0" />
  <!-- Identity assigned by the Microsoft Store (Partner Center). -->

  <Properties>
    <DisplayName>Election Explorer</DisplayName>
    <PublisherDisplayName>WheelGroupTech</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="ElectionExplorer"
      Executable="ElectionExplorer.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Election Explorer"
        Description="View, compare, and analyze election voter-list data."
        BackgroundColor="#FFFFFF"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Images\Wide310x150Logo.png"
          Square71x71Logo="Images\Square71x71Logo.png"
          Square310x310Logo="Images\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Full-trust Win32 desktop app packaged as MSIX. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
