# Line endings, the same on every machine whatever its core.autocrlf says.
# Text files are stored with LF (as they all are) and checked out with the platform's own
# endings: CRLF on Windows, LF on macOS and Linux.
* text=auto

# Shell scripts run on macOS and Linux (and in WSL from a Windows checkout): always LF.
*.sh text eol=lf

# Visual Studio and MSIX packaging files are only used on Windows: always CRLF.
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.wapproj text eol=crlf
*.appxmanifest text eol=crlf
*.rc text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files git should never convert or diff as text.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.docx binary
*.xlsx binary
*.xls binary
*.pptx binary
*.msix binary
*.msixbundle binary
*.exe binary
*.dll binary
